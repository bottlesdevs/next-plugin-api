package bottles:plugin@0.1.0;

interface types {
    /// A command declared by the plugin manifest and resolved by the host.
    record command {
        id: string,
        title: string,
        description: string,
        usage: string,
        requires-bottle: bool,
    }

    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    enum operating-system {
        linux,
        macos,
        windows,
    }

    enum architecture {
        x8664,
        aarch64,
    }

    record platform {
        operating-system: operating-system,
        architecture: architecture,
    }

    record environment-variable {
        name: string,
        value: string,
    }

    enum dll-override-mode {
        native-builtin,
        builtin-native,
        native,
        builtin,
        disabled,
    }

    record dll-override {
        dll: string,
        mode: dll-override-mode,
    }

    record program {
        id: string,
        name: string,
        executable: string,
        arguments: list<string>,
        working-directory: option<string>,
        new-console: bool,
    }

    /// Input for registering a program. The host generates and returns its ID.
    record new-program {
        name: string,
        executable: string,
        arguments: list<string>,
        working-directory: option<string>,
        new-console: bool,
    }

    enum storage {
        standard,
        virgo,
    }

    enum component-slot {
        winebridge,
        runner,
        umu,
        dxvk,
        vkd3d,
        nvapi,
        latency-flex,
    }

    record component {
        id: string,
        name: string,
        version: string,
        slot: component-slot,
    }

    record dependency {
        id: string,
        name: string,
        version: string,
    }
}

interface logging {
    use types.{log-level};

    log: func(level: log-level, message: string);
}

interface platform {
    use types.{platform};

    current: func() -> platform;
}

interface settings {
    /// Returns one JSON-encoded setting, or none when it is unset.
    get: func(key: string) -> result<option<string>, string>;
}

interface key-value-store {
    get: func(key: string) -> result<option<string>, string>;
    set: func(key: string, value: string) -> result<_, string>;
    delete: func(key: string) -> result<_, string>;
}

interface http-client {
    record header {
        name: string,
        value: string,
    }

    record response {
        status: u16,
        final-url: string,
        headers: list<header>,
        body: list<u8>,
    }

    /// Performs an HTTPS GET. The host validates every redirect and bounds the response.
    get: func(url: string, headers: list<header>) -> result<response, string>;
}

interface process {
    use types.{environment-variable};

    record command {
        executable: string,
        arguments: list<string>,
        environment: list<environment-variable>,
        timeout-milliseconds: option<u32>,
    }

    record output {
        status: option<s32>,
        stdout: list<u8>,
        stderr: list<u8>,
    }

    /// Runs an executable directly, without a shell or inherited environment.
    run: func(command: command) -> result<output, string>;
}

interface filesystem {
    enum file-kind {
        file,
        directory,
        symlink,
        other,
    }

    record metadata {
        kind: file-kind,
        size: u64,
    }

    record directory-entry {
        name: string,
        kind: file-kind,
    }

    /// A user-configured, read-only directory. All paths are relative to its root.
    resource read-root {
        name: func() -> string;
        read: func(path: string) -> result<list<u8>, string>;
        metadata: func(path: string) -> result<metadata, string>;
        read-directory: func(path: string) -> result<list<directory-entry>, string>;
    }

    read-root-names: func() -> list<string>;
    open-read-root: func(name: string) -> result<read-root, string>;

    /// Returns the virtual path of the plugin's private writable WASI directory.
    work-directory: func() -> string;
}

interface bottle {
    use types.{component, dependency, dll-override, dll-override-mode, environment-variable, new-program, program, storage};

    /// The selected bottle for one invocation. It cannot outlive that invocation.
    resource bottle {
        id: func() -> string;
        name: func() -> string;
        storage: func() -> storage;
        environment: func() -> list<environment-variable>;
        dll-overrides: func() -> result<list<dll-override>, string>;
        programs: func() -> list<program>;
        components: func() -> list<component>;
        dependencies: func() -> list<dependency>;

        set-environment-variable: func(name: string, value: string) -> result<_, string>;
        unset-environment-variable: func(name: string) -> result<_, string>;
        set-dll-override: func(dll: string, mode: dll-override-mode) -> result<_, string>;
        unset-dll-override: func(dll: string) -> result<_, string>;
        add-program: func(program: new-program) -> result<string, string>;
        remove-program: func(id: string) -> result<_, string>;
        set-component: func(id: string) -> result<_, string>;
        install-dependency: func(id: string) -> result<_, string>;
        run-program: func(id: string) -> result<u32, string>;
        kill-program: func(id: string) -> result<_, string>;
        stop: func() -> result<_, string>;
    }
}

world plugin {
    import logging;
    import platform;
    import settings;
    import key-value-store;
    import http-client;
    import process;
    import filesystem;
    import bottle;

    use types.{command};
    use bottle.{bottle};

    export init-plugin: func();
    export run-command: func(
        command: command,
        arguments: list<string>,
        bottle: option<borrow<bottle>>,
    ) -> result<string, string>;
}
