package bottles:plugin@0.1.0;

interface account-link {
    resource interaction {
        request-input: func(url: string, instructions: string) -> result<string, string>;
    }
}

interface account-provider {
    use account-link.{interaction};

    record account-identity {
        account-id: string,
        display-name: string,
    }

    record linked-account {
        identity: account-identity,
        credential: option<list<u8>>,
    }

    link-account: func(
        interaction: borrow<interaction>,
    ) -> result<linked-account, string>;

}

interface library-provider {
    /// One installed title that this provider can launch.
    record library-entry {
        id: string,
        title: string,
    }

    list-entries: func() -> result<list<library-entry>, string>;

    /// Completes when the launch request finishes, not when the title exits.
    launch: func(id: string) -> result<_, string>;
}

world account {
    import account-link;
    export account-provider;
}

world library {
    export library-provider;
}

world storefront {
    include account;
    include library;
}
