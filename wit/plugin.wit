package bottles:plugin@0.1.0;

interface account-link {
    resource interaction {
        request-input: func(url: string, instructions: string) -> result<string, string>;
    }
}

interface account-provider {
    use account-link.{interaction};

    record account-identity {
        account-id: string,
        display-name: string,
    }

    record linked-account {
        identity: account-identity,
        credential: option<list<u8>>,
    }

    link-account: func(
        interaction: borrow<interaction>,
    ) -> result<linked-account, string>;

}

interface library-provider {
    record owned-game {
        id: string,
        title: string,
    }

    record authentication {
        access: list<u8>,
        /// `none` retains the stored credential; `some` replaces it.
        updated-credential: option<list<u8>>,
    }

    authenticate: func(
        account-id: string,
        credential: option<list<u8>>,
    ) -> result<authentication, string>;

    list-games: func(
        account-id: string,
        access: list<u8>,
    ) -> result<list<owned-game>, string>;

}

world account {
    import account-link;
    export account-provider;
}

world library {
    export library-provider;
}

world storefront {
    include account;
    include library;
}
