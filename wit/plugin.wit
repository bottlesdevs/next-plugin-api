package bottles:plugin@0.1.0;

interface account-link {
    resource interaction {
        request-input: func(url: string, instructions: string) -> result<string, string>;
    }
}

interface storefront-provider {
    use account-link.{interaction};

    record account-identity {
        account-id: string,
        display-name: string,
    }

    record linked-account {
        identity: account-identity,
        credential: option<list<u8>>,
    }

    link-account: func(
        interaction: borrow<interaction>,
    ) -> result<linked-account, string>;

    record owned-game {
        id: string,
        title: string,
    }

    record listed-games {
        /// Enumeration may fail after authentication has refreshed successfully.
        games: result<list<owned-game>, string>,
        /// `none` keeps the current credential; `some` replaces it.
        updated-credential: option<list<u8>>,
    }

    /// An outer error carries no credential update. After refreshing, return
    /// a listed-games value even if enumeration fails, so the host can persist
    /// the replacement before reporting the enumeration error.
    list-games: func(
        account-id: string,
        credential: option<list<u8>>,
    ) -> result<listed-games, string>;
}

world storefront {
    import account-link;
    export storefront-provider;
}
